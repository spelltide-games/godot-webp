[configuration]

entry_symbol = "godot_webp_library_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]
macos.debug = "bin/macos/libgodot-webp.macos.template_release.dylib"
macos.release = "bin/macos/libgodot-webp.macos.template_release.dylib"

macos.arm64.debug = "bin/macos/libgodot-webp.macos.template_release.arm64.dylib"
macos.arm64.release = "bin/macos/libgodot-webp.macos.template_release.arm64.dylib"

ios.arm64.debug = "bin/ios/libgodot-webp.ios.template_release.arm64.dylib"
ios.arm64.release = "bin/ios/libgodot-webp.ios.template_release.arm64.dylib"

windows.x86_64.debug = "bin/windows/godot-webp.windows.template_release.x86_64.dll"
windows.x86_64.release = "bin/windows/godot-webp.windows.template_release.x86_64.dll"

android.arm64.debug = "bin/android/libgodot-webp.android.template_release.arm64.so"
android.arm64.release = "bin/android/libgodot-webp.android.template_release.arm64.so"
